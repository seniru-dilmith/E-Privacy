        BD["Bulletin board<br/>/board"]
    end
    subgraph ADM["Admin session only"]
        MO["Monitor<br/>/monitor"]
        DBV["Database<br/>/database/:table"]
    end
    LG --> CA
    LG --> BD
    LG --> MO
    CA --> AN
    CA --> RC
    CA --> SD
    MO --> DBV
    classDef trusted fill:#e3efe9,stroke:#0f6b5c
