# Copy to .env and replace every "change-me" value.
# docker compose passes each service only the variables it needs.

# ---- web ----
WEB_PORT=8080

# ---- mysql (cloud side only) ----
MYSQL_ROOT_PASSWORD=change-me
MYSQL_DATABASE=eprivacy
MYSQL_USER=eprivacy
MYSQL_PASSWORD=change-me

# ---- cloud (untrusted analytics engine) ----
# Groups with fewer records than this are never released (policy V4).
K_MIN=10
SESSION_TTL_HOURS=8
# Service account the hospital agent uses to talk to the cloud gateway.
CLOUD_OWNER_USER=hospital-agent
CLOUD_OWNER_PASSWORD=change-me
AUDITOR_USER=auditor
AUDITOR_PASSWORD=change-me
ADMIN_USER=admin
ADMIN_PASSWORD=change-me

# ---- owner (trusted hospital domain) ----
OWNER_USER=records-officer
OWNER_PASSWORD=change-me
# 1024, 2048 or 3072
DEFAULT_KEY_BITS=2048
