# For running the owner agent on the host: cp .env.local.example .env.local
# `npm run dev -w owner` loads it automatically.
PORT=4000
CLOUD_URL=http://localhost:5000
# must match the cloud's CLOUD_OWNER_* values
CLOUD_OWNER_USER=hospital-agent
CLOUD_OWNER_PASSWORD=change-me
OWNER_USER=records-officer
OWNER_PASSWORD=change-me
DEFAULT_KEY_BITS=1024
DATASET=../data/hospital_admissions.csv
KEY_DIR=.data/keys
